{
  "name": "sanity-plugin-skyneta11y-pdf-remediation",
  "version": "1.0.0",
  "description": "AI-powered PDF accessibility remediation for Sanity Studio - upload PDFs, scan website PDFs, and download WCAG / PDF/UA remediated files.",
  "keywords": [
    "accessibility",
    "ada",
    "pdf",
    "pdf-remediation",
    "pdf-ua",
    "sanity",
    "sanity-plugin",
    "section-508",
    "wcag"
  ],
  "homepage": "https://github.com/skynettechnologies/sanity-plugin-skyneta11y-pdf-remediation#readme",
  "bugs": {
    "url": "https://github.com/skynettechnologies/sanity-plugin-skyneta11y-pdf-remediation/issues"
  },
  "license": "MIT",
  "author": "Skynet Technologies USA LLC <developer3@skynettechnologies.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/skynettechnologies/sanity-plugin-skyneta11y-pdf-remediation.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && plugin-kit verify-package --silent && pkg-utils build --strict --clean && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "styles": "node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {},
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.0",
    "@sanity/plugin-kit": "^10.0.9",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.13.2",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^5 || ^6.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "scripts": false,
      "srcIndex": false
    }
  }
}
